    "import numpy as np\n",
    "\n",
    "a1 = np.array([1,2,3,4,5], dtype=np.int8)\n",
    "print(a1,a1.dtype)\n",
    "\n",
    "# 通过astype转换\n",
    "a2 = a1.astype(dtype=np.float64)\n",
    "print(a2,a2.dtype)"
   ],
