   "source": [
    "import numpy as np\n",
    "\n",
    "a1 = np.arange(1,10)\n",
    "print(a1)\n",
    "# 获取索引3的数据\n",
    "print(a1[3])\n",
    "# 从索引2开始到索引9(不包含),步长2\n",
    "print(a1[slice(2,9,2)])"
   ],
